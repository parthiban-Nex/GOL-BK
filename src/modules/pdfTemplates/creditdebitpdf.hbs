<!DOCTYPE html>
<html>
<head>
    <title>CreditDebit</title>
    <style>
        body {
            font-family: 'Inter';
            margin: 0;
            padding: 0;
            font-size: 12px; /* Default font size */
        }

        .header {
            text-align: right;
            padding: 0px 20px;
            margin-bottom: -10px;
        }

        .header img {
            max-width: 150px;
        }

        .line {
            border-bottom: 1px solid #000;
            margin: 10px 0;
        }

        .branch-details, .customer-details, .booking-details {
            padding: 0 20px;
        }

        .center-text {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin: 20px 0;
            color: darkred;
        }

        .details-container {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
        }

        .details-box {
            width: 48%;
            padding: 10px;
        }

        .details-box p {
            margin: 0;
            padding: 3px 0; /* Reduced padding */
            font-size: 12px; /* Reduced font size for key-value pairs */
        }

        .details-box .key {
            font-weight: bold;
        }

        .details-table, .items-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }

        .details-table-new, .items-table, .details-table-new1 {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }

        .details-table-new th, .details-table-new td, .items-table th, .items-table td {
            border: 1px solid #ffffff;
            padding: 0px; /* Reduced padding */
            text-align: left;
            font-size: 10px; /* Reduced font size for table content */
        }

        .details-table-new1 th, .details-table-new1 td, .items-table th, .items-table td {
            border: 1px solid #ffffff;
            padding: 0px; /* Reduced padding */
            text-align: left;
            font-size: 10px; /* Reduced font size for table content */
        }

        .details-table td, .items-table th, .items-table td {
            border: 1px solid #000;
            padding: 5px; /* Reduced padding */
            text-align: left;
            font-size: 10px; /* Reduced font size for table content */
        }

        .details-table th {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            font-size: 10px;
        }

        .footer {
            padding: 10px 20px;
            font-size: 12px; /* Reduced font size for footer content */
        }

        .footer .signatures {
            display: flex;
            justify-content: space-between;
        }

        .bold {
            font-weight: bold;
        }

        .details-table-new1 th,
        .details-table-new1 td {
        border: 1px solid #ffffff;
        padding: 1px;
        /* Reduced padding */
        text-align:
            left;
        font-size: 12px;
        vertical-align: top;
        }
          
        .details-table-sign th,
        .details-table-sign td {
        border: 1px solid #ffffff;
        padding: 0px;
        /*
        Reduced padding */
        text-align: left;
        font-size: 12px;
        /* Reduced font size
        for table content */
        }
    </style>
</head>
<body>
    <div style="display: flex; justify-content:space-between">
    <div style="display:flex">
        <table class="details-table-new" style="margin-left: 10px;">
            <tbody>
                <tr>
                                  <td>{{outlet.outletName}}</td>

                </tr>
                <tr>
                    <td >{{outlet.address}},</td>
                </tr>
                <tr>
                    <td >{{outlet.city}},{{outlet.state}},{{outlet.pincode}}</td>
                </tr>
                <tr>
                    <td >Mobile: {{outlet.mobile}},</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="header">
        <img src="data:image/png;base64,{{base64Logo}}" alt="Logo" style="height: 30px; width:100px">
    </div>
    </div>
    <div class="line"></div>
    <div class="outlet-details" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <p style="margin: 0;">
        <br /><span class="key">Email:</span> {{outlet.email}},
        <br /><span class="key">GSTIN:</span> {{outlet.dealerGstin}}
        {{#if hasDBO}}
        <br /><span class="key">IRN Number:</span> {{creditNoteUpdate.irn_no}}
        {{!-- <br /><span class="key">IRN Date:</span> {{creditNoteUpdate.invoice_bdoack_date}} --}}
          <br /><span class="key">IRN Date:</span> {{BdoDate}}
          {{/if}}
    </p>
    {{#if hasDBO}} 
    <img
        src="{{qrCodeImage}}"
        alt="QR Code"
        style="width: 150px; height: 150px; margin-left: 20px;"
    />
     {{/if}}
    </div>

    <!-- Horizontal line -->
    <div class='line'></div>

    <div class='center-text'>{{creditDebit.purpose}}</div>

    <!-- Horizontal line -->
    <div class='line'></div>

    <table class='details-table-new1'>

    <body>
      <tr>
        <th style='width: 20%;'>Account</th>
        <td style='width: 5%;'>:</td>
        <td style='width: 25%;'></td>
        <th style='width: 20%; '>Document Name</th>
        <td style='width: 5%; '>:</td>
        <td style='width: 25%; text-align:left'>{{creditDebit.doc_no}}</td>
      </tr>
      <tr>
        <th style='width: 20%;'>Contact</th>
        <td style='width: 5%;'>:</td>
        <td style='width: 25%;'>{{creditDebit.decryptedCustomerName}}</td>
        <th style='width: 20%; '>Document Date</th>
        <td style='width: 5%; '>:</td>
        <td style='width: 25%; text-align:left'>{{creditDebit.createdAt}}</td>
      </tr>
      <tr>
        <th style='width: 20%;'>Customer Code</th>
        <td style='width: 5%;'>:</td>
        <td style='width: 25%;'>{{creditDebit.customer_code}}</td>
        <th style='width: 20%; '>Customer Address</th>
        <td style='width: 5%; '>:</td>
        <td style='width: 25%; text-align:left'>{{creditDebit.address1}}</td>
      </tr>
      <tr>
        <th style='width: 20%;'>Business Unit</th>
        <td style='width: 5%;'>:</td>
        <td style='width: 25%;'>{{outlet.name}}</td>
        <th style='width: 20%; '>Vehicle Number</th>
        <td style='width: 5%; '>:</td>
        <td style='width: 25%; text-align:left'>{{creditDebit.reg_no}}</td>
      </tr>
      <tr>
        <th style='width: 20%;'>Customer GSTIN</th>
        <td style='width: 5%;'>:</td>
        <td style='width: 25%;'>{{creditDebit.customer_gstin}}</td>
        <th style='width: 20%; '> </th>
        <td style='width: 5%; '> </td>
        <td style='width: 25%; text-align:left'> </td>
      </tr>
    </body>
  </table>
    {{#if showLabour}}
    <table class="details-table">
        <thead>
            <tr style="border: 1px solid #ffffff;">
                <th colspan="16" style="border: #ffffff; border-bottom:1px solid #000; text-align:left">LABOURS</th>
            </tr>
            <tr>
                <th style="width: 3%;">SNO</th>
                <th>CODE</th>
                <th>DESCRIPTION</th>
                <th>HSN/SAC</th>
                <th>QTY</th>
                <th>AMOUNT</th>
                <th>DISC</th>
                <th>CGST %</th>
                <th>CGST</th>
                <th>SGST %</th>
                <th>SGST</th>
                <th>IGST %</th>
                <th>IGST</th>
                <th style="width: 10%;">AMOUNT</th>
            </tr>
        </thead>
        <tbody>
            {{#each labours}}
            <tr>
                <td>{{this.sno}}</td>
                <td>{{this.rot_code}}</td>
                <td>{{this.description}}</td>
                <td>{{this.hsn}}</td>
                <td>{{this.quantity}}</td>
                <td>{{this.valdisc}}</td>
                <td>{{this.discount}}</td>
                <td>{{this.cgst}}</td>
                <td>{{this.cgstamt}}</td>
                <td>{{this.sgst}}</td>
                <td>{{this.sgstamt}}</td>
                <td>{{this.igst}}</td>
                <td>{{this.igstamt}}</td>
                <td>{{this.totalamt}}</td>
            </tr>
            {{/each}}
            <tr>
                <th colspan="4" style="text-align: right;">SUB TOTAL</th>
                <td>{{totalLaborQuantity}}</td>
                <td>{{labBeforeTaxAmt}}</td>
                <td></td>
                <td></td>
                <td>{{totalLaborCGst}}</td>
                <td></td>
                <td>{{totalLaborSGst}}</td>
                <td></td>
                <td>{{totalLaborIGst}}</td>
                <td>{{totalLaborAmount}}</td>
            </tr>
            <tr>
                <th colspan="13" style="text-align: right;">TOTAL GST on LABOURS</th>
                <td>{{totalGstOnLabor}}</td>
            </tr>
            <tr>
                <th colspan="13" style="text-align: right;">TOTAL Discount on LABOURS</th>
                <td>{{totalLaborDiscount}}</td>
            </tr>
            <tr>
                <th colspan="13" style="text-align: right;">Round off</th>
                <td>{{labRound}}</td>
            </tr>
            <tr>
                <th colspan="13" style="text-align: right;">Grand Total of LABOURS</th>
                <td>{{labAmtRound}}</td>
            </tr>
        </tbody>
    </table>
    {{/if}}
    {{#if showSpares}}
    <table class='details-table'>
      <thead>
         <tr style="border: 1px solid #ffffff;">
                <th colspan="16" style="border: #ffffff; border-bottom:1px solid #000; text-align:left">SPARES</th>
            </tr>
        <tr>
          <th style='width: 3%;'>SNO</th>
          <th>CODE</th>
          <th>DESCRIPTION</th>
          <th>HSN/SAC</th>
          <th>QTY</th>
          <th>PER QTY RATE</th>
          {{! <th>Taxable value</th>
                <th>DISC</th>
                <th>Tax Val after DISC</th> }}
          <th>CGST %</th>
          <th>CGST</th>
          <th>SGST %</th>
          <th>SGST</th>
          <th>IGST %</th>
          <th>IGST</th>
          <th style='width: 10%;'>AMOUNT</th>
        </tr>
      </thead>
      <tbody>
        {{#each parts}}
          <tr>
            <td>{{this.sno}}</td>
            <td>{{this.code}}</td>
            <td>{{this.description}}</td>
            <td>{{this.hsn}}</td>
            <td>{{this.quantity}}</td>
            <td>{{this.rate}}</td>
            {{!-- <td>{{this.totalval}}</td>
                <td>{{this.discount}}</td>
                <td>{{this.valafterdisc}}</td> --}}
            <td>{{this.cgst}}</td>
            <td>{{this.cgstamt}}</td>
            <td>{{this.sgst}}</td>
            <td>{{this.sgstamt}}</td>
            <td>{{this.igst}}</td>
            <td>{{this.igstamt}}</td>
            <td>{{this.totalamt}}</td>
          </tr>
        {{/each}}
        <tr>
          <th colspan='4' style='text-align: right;'>SUB TOTAL</th>
          <td>{{totalPartsQuantity}}</td>
          <td></td>
          <td></td>
          <td>{{totalPartsCGst}}</td>
          <td></td>
          <td>{{totalPartsSGst}}</td>
          <td></td>
          <td>{{totalPartsIGst}}</td>
          <td>{{totalPartsAmount}}</td>
          {{! <td></td>
                <td></td>
                <td></td> }}
        </tr>
        <tr>
          <th colspan='12' style='text-align: right;'>TOTAL GST on SPARES</th>
          <td>{{totalGstOnParts}}</td>
        </tr>
        {{! <tr>
                <th colspan="12" style="text-align: right;">TOTAL DISCOUNT on SPARES</th>
                <th></th>
            </tr> }}
        <tr>
          <th colspan='12' style='text-align: right;'>Round off</th>
          <td>{{partRound}}</td>
        </tr>
        <tr>
          <th colspan='12' style='text-align: right;'>Grand Total of SPARES</th>
          <td>{{partAmtRound}}</td>
        </tr>
        <tr>
          <th colspan='12' style='text-align: right;'>GRAND TOTAL</th>
          <td>{{totalLaborPartsAmountRnd}}</td>
        </tr>
      </tbody>
    </table>
    {{/if}}
    <br/>
    <div class='footer'>
    <table class='details-table-sign'>
      <thead>
        <tr>
          <th></th>
          <th style='text-align: left; padding-top:10px; width:20%'>For
            {{outlet.name}}</th>
        </tr>
        <tr>
          <th style='padding-left:0px; padding-top:10px;'>______________________</th>
          <th style='text-align: left; padding-top:10px; width:20%'>______________________</th>
        </tr>
        <tr>
          <th style='padding-left:0px; padding-top:10px;'>Customer Signature</th>
          <th style='text-align: left; padding-top:10px; width:20%'>Authorized
            Signature</th>
        </tr>
      </thead>
    </table>
  </div>
</body>
</html>