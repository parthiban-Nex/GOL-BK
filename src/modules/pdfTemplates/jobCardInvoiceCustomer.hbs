<html>
  <head>
    <title>CustomerInvoice</title>
    <style>
        body {
            font-family: 'Inter';
            margin: 0;
            padding: 0;
            font-size: 12px; /* Default font size */
        }

        .header {
            text-align: right;
            padding: 0px 20px;
            margin-bottom: -10px;
        }

        .header img {
            max-width: 150px;
        }

        .line {
            border-bottom: 1px solid #000;
            margin: 10px 0;
        }

        .branch-details, .customer-details, .booking-details {
            padding: 0 20px;
        }

        .center-text {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin: 20px 0;
            color: darkred;
        }

        .details-container {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
        }

        .details-box {
            width: 48%;
            padding: 10px;
        }

        .details-box p {
            margin: 0;
            padding: 3px 0; /* Reduced padding */
            font-size: 12px; /* Reduced font size for key-value pairs */
        }

        .details-box .key {
            font-weight: bold;
        }

        .details-table, .items-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }

        .details-table-new, .items-table, .details-table-new1 {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }

        .details-table-new th, .details-table-new td, .items-table th, .items-table td {
            border: 1px solid #ffffff;
            padding: 0px; /* Reduced padding */
            text-align: left;
            font-size: 10px; /* Reduced font size for table content */
        }

        .details-table-new1 th, .details-table-new1 td, .items-table th, .items-table td {
            border: 1px solid #ffffff;
            padding: 0px; /* Reduced padding */
            text-align: left;
            font-size: 10px; /* Reduced font size for table content */
        }

        .details-table td, .items-table th, .items-table td {
            border: 1px solid #000;
            padding: 5px; /* Reduced padding */
            text-align: left;
            font-size: 10px; /* Reduced font size for table content */
        }

        .details-table th {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            font-size: 10px;
        }

        .footer {
            padding: 10px 20px;
            font-size: 12px; /* Reduced font size for footer content */
        }

        .footer .signatures {
            display: flex;
            justify-content: space-between;
        }

        .bold {
            font-weight: bold;
        }
    </style>
</head>
  <body>
    <div style='display: flex; justify-content:space-between'>
      <div style="display:flex">
        <table class="details-table-new" style="margin-left: 10px;">
            <tbody>
                <tr>
                                  <td>{{outlet.outletName}}</td>
                </tr>
                <tr>
                    <td >{{outlet.address}},</td>
                </tr>
                <tr>
                    <td >{{outlet.city}},{{outlet.state}},{{outlet.pincode}}</td>
                </tr>
                <tr>
                    <td >Mobile: {{outlet.mobile}},</td>
                </tr>
            </tbody>
        </table>
    </div>
      <div class="header">
        <img src="data:image/png;base64,{{base64Logo}}" alt="Logo" style="height: 30px; width:100px">
    </div>
    </div>
    <div class='line'></div>
    <table class="details-table-new1">
        <tbody>
            <tr>
                <td style="width: 20%;">PAN</td>
                <td style="width: 5%;">:</td>
                <td style="width: 25%;"></td>
                <td style="width: 20%; text-align:right">Job Card no</td>
                <td style="width: 5%; text-align:right">:</td>
                <td style="width: 25%; text-align:left">{{customer.documentName}}</td>
            </tr>
            <tr>
                <td style="width: 20%;">GSTIN</td>
                <td style="width: 5%;">:</td>
                <td style="width: 25%;">{{outlet.dealerGstin}}</td>
                <td style="width: 20%; text-align:right">Bill Date</td>
                <td style="width: 5%; text-align:right">:</td>
                <td style="width: 25%; text-align:left">{{customer.documentDate}}</td>
            </tr>
            <tr>
                <td style="width: 20%;">CIN</td>
                <td style="width: 5%;">:</td>
                <td style="width: 25%;"></td>
                <td style="width: 20%; text-align:right">Bill Type</td>
                <td style="width: 5%; text-align:right">:</td>
                <td style="width: 25%; text-align:left">{{customer.InvoiceType}}</td>
            </tr>
            <tr>
                <td style="width: 20%;">Invoice Number</td>
                <td style="width: 5%;">:</td>
                <td style="width: 25%;">{{customer.InvoiceNumber}}</td>
                <td style="width: 20%;"></td>
                <td style="width: 5%;"></td>
                <td style="width: 25%;"></td>
            </tr>
            <tr>
                <td style="width: 20%;">IRN Number</td> 
                <td style="width: 5%;">:</td>
                 <td style="width: 25%;">{{bdoObj.irn_no}}</td>
                <td style="width: 25%;"></td>
            </tr>
            <tr>
                <td style="width: 20%;">IRN Ack Date</td>
                <td style="width: 5%;">:</td>
                <td style="width: 25%;">{{bdoObj.irn_date}}</td>
                <td style="width: 25%;"></td>
            </tr>

            <!-- QR Code Row (BOTTOM, RIGHT ALIGNED) -->
          {{#if bdoObj.qr_code}}
          <tr>
            <td colspan="6" style="text-align:right; padding-top:0px;">
              <img
                src="{{bdoObj.qr_code}}"
                alt="QR Code"
                style="width:100px; height:100px;"
              />
            </td>
          </tr>
          {{/if}}
        </tbody>
    </table>
        <table class="details-table">
        <thead>
            <tr style="border: 1px solid #ffff;">
                <th colspan="4" style="border: #ffffff; border-bottom:1px solid #000; text-align: center;"><u>Tax Invoice</u></th>
            </tr>
            <tr>
                <th colspan="2" style="text-align: center;">BILLING TO</th>
                <th colspan="2" style="text-align: center;">SHIP TO/Place of supply</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="width: 25%;">Insurance/Cust code</td>
                <td style="width: 25%;">{{customer.customer_code}}</td>
                <td style="width: 25%;">Customer Code</td>
                <td style="width: 25%;">{{customer.customer_code}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Insurance/Cust name</td>
                <td style="width: 25%;">{{customer.name}}</td>
                <td style="width: 25%;">Customer Name</td>
                <td style="width: 25%;">{{customer.name}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Insurer/Cust GSTIN</td>
                <td style="width: 25%;">{{customer.gstin}}</td>
                <td style="width: 25%;">Customer GSTIN</td>
                <td style="width: 25%;">{{customer.gstin}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Billing Address</td>
                <td style="width: 25%;">{{customer.address}}</td>
                <td style="width: 25%;">Delivery Address</td>
                <td style="width: 25%;">{{customer.address}}
                    <br />
            {{customer.mobile}}
                </td>
            </tr>
        </tbody>
    </table>
    <table class="details-table">
        <thead>
            <tr>
                <th style="text-align: center;" colspan="2" >VEH/ENG DETAILS</th>
                <th style="text-align: center;" colspan="2">JOBCARD DETAILS</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="width: 25%;">Vehicle</td>
                <td style="width: 25%;">{{customer.model}}</td>
                <td style="width: 25%;">Creation</td>
                <td style="width: 25%;">{{customer.checkinTime}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Registration No</td>
                <td style="width: 25%;">{{customer.regNo}}</td>
                <td style="width: 25%;">Repair Type</td>
                <td style="width: 25%;">{{customer.repairType}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Chassis No</td>
                <td style="width: 25%;">{{customer.chassisNo}}</td>
                <td style="width: 25%;">Service Type</td>
                <td style="width: 25%;">{{customer.serviceType}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Engine No</td>
                <td style="width: 25%;">{{customer.engNo}}</td>
                <td style="width: 25%;">Km Reading</td>
                <td style="width: 25%;">{{customer.kmReading}}</td>
            </tr>
            <tr>
                <td style="width: 25%;">Contact person</td>
                <td style="width: 25%;"></td>
                <td style="width: 25%;">Customer state code</td>
                <td style="width: 25%;"></td>
            </tr>
            <tr>
                <td style="width: 25%;">Service Engineer</td>
                <td style="width: 25%;"></td>
                <td style="width: 25%;">Is reverse charge apply</td>
                <td style="width: 25%;"></td>
            </tr>
        </tbody>
    </table>
    <table class='details-table'>
      <thead>
        <tr>
          <th
            colspan='14'
            style='border: #ffffff; border-bottom:1px solid #000; text-align:left'
          >LABOURS</th>
        </tr>
        <tr>
          <th style='width: 3%;'>SNO</th>
          <th>CODE</th>
          <th>DESCRIPTION</th>
          <th>HSN/SAC</th>
          <th>QTY</th>
          <th>TOTAL VALUE</th>
          <th>DISC</th>
          {{! <th>Tax Val after DISC</th> }}
          <th>CGST %</th>
          <th>CGST</th>
          <th>SGST %</th>
          <th>SGST</th>
          <th>IGST %</th>
          <th>IGST</th>
          <th style='width: 10%;'>AMOUNT</th>
        </tr>
      </thead>
      <tbody>
        {{#each labours}}
          <tr>
            <td style='text-align: center;'>{{this.sno}}</td>
            <td style='text-align: center;'>{{this.rot_code}}</td>
            <td style='text-align: center;'>{{this.description}}</td>
            <td style='text-align: center;'>{{this.hsn}}</td>
            <td>{{this.quantity}}</td>
            <td>{{this.totalCustomeramt}}</td>
            <td>{{this.discount}}</td>
            {{!-- <td>{{this.valafterdisc}}</td> --}}
            <td>{{this.cgst}}</td>
            <td>{{this.cgstCustomerAmount}}</td>
            <td>{{this.sgst}}</td>
            <td>{{this.sgstCustomerAmount}}</td>
            <td>{{this.igst}}</td>
            <td>{{this.igstCustomerAmount}}</td>
            <td>{{this.totalCustomeramtwithTx}}</td>
          </tr>
        {{/each}}
        <tr>
          <td colspan='4' style='text-align: right;'>SUB TOTAL</td>
          <td>{{totalLaborQuantity}}</td>
          <td></td>
          <td>{{totalCustomerLaborDiscount}}</td>
          <td></td>
          <td>{{totalCustomerLaborSGst}}</td>
          {{! <td></td> }}
          <td></td>
          {{! <td></td> }}
          <td>{{totalCustomerLaborCGst}}</td>
          <td></td>
          <td>{{totalCustomerLaborIGst}}</td>
          <td>{{totalCustomerLaborAmount}}</td>
        </tr>
        <tr>
          <td colspan='13' style='text-align: right;'>TOTAL GST on LABOURS</td>
          <td>{{totalCustomerGstOnLabor}}</td>
        </tr>
        <tr>
          <td colspan='13' style='text-align: right;'>TOTAL DISCOUNT on LABOURS</td>
          <td>{{totalCustomerLaborDiscount}}</td>
        </tr>
        <tr>
          <td colspan='13' style='text-align: right;'>TOTAL of LABOURS</td>
          <td>{{totalCustomerLaborAmount}}</td>
        </tr>
      </tbody>
    </table>

    <table class='details-table'>
      <thead>
        <tr>
          <th style='width: 50%;'>ADVICE</th>
          <th style='width: 50%;'> SERVICE ENGINEER REMARKS</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style='width: 50%;'>{{customer.customerVoice}}</td>
          <td style='width: 50%;'>{{customer.serviceEngineerRemarks}}</td>
        </tr>
      </tbody>
    </table>
